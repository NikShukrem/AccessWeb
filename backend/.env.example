# Development Configuration Example
# Copy this file to .env and modify for your local environment

# Environment mode
NODE_ENV=development

# Server
PORT=8080
HTTPS=false

# SECURITY: JWT Secret (must be changed for production!)
JWT_SECRET=dev-secret-key-12345-change-in-production

# Database
DB_PATH=./data/accessweb.db

# SECURITY: CORS Origins (development allows localhost)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Demo credentials (development only):
# admin / admin123
# contracts / contracts123
# finance / finance123
