# PRODUCTION CONFIGURATION - AccessWeb Backend
# This file is for PRODUCTION deployment only
# NEVER commit secrets to git!

# Environment mode
NODE_ENV=production

# Server configuration
PORT=8080
HTTPS=true

# SECURITY: Must be set! Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DO NOT use default value in production!
JWT_SECRET=GENERATE_AND_SET_THIS_VALUE

# SECURITY: Database path
DB_PATH=./data/accessweb.db

# SECURITY: CORS - specify exact origins (NOT *)
# Example: http://yourdomain.eg,https://yourdomain.eg
CORS_ORIGINS=https://yourdomain.eg

# Optional: Database connection for PostgreSQL (future)
# DB_HOST=db.example.com
# DB_USER=accessweb_user
# DB_PASSWORD=SECURE_PASSWORD
