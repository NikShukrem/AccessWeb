{
  "name": "AccessWeb",
  "version": "1.0.0",
  "description": "Web-based Microsoft Access alternative - optimized for slow internet (3G/Edge)",
  "main": "index.html",
  "scripts": {
    "generate-test": "node generate-test-data.js",
    "serve": "python -m http.server 8000",
    "test": "echo 'Open http://localhost:8000 in your browser'",
    "backend:install": "cd backend && npm install",
    "backend:start": "cd backend && npm start",
    "backend:dev": "cd backend && npm run dev",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down"
  },
  "keywords": [
    "database",
    "access",
    "crud",
    "offline-first",
    "indexeddb",
    "web-app"
  ],
  "author": "Development Team",
  "license": "MIT",
  "features": {
    "tables": ["ACID", "Contracts", "Finance"],
    "storage": "IndexedDB + IndexedDB",
    "export": ["CSV", "Excel"],
    "import": ["JSON", "CSV", "Excel"],
    "optimization": "Virtual scrolling, Lazy loading, Service Worker",
    "internet": "Works on 3G/Edge, fully offline after first load",
    "size": "Single HTML file < 100KB"
  }
}
